<?xml version="1.0" encoding="UTF-8"?>
<!-- ======================================================= -->
<!-- ========== Template Management Notes ========== -->
<!--
    This XML document modifies and overrides templates from MIR.
    Templates are organized in dedicated sections below:
        1. New
        2. Overrides
        3. Modifications
    Sections are provided for Admin, Host, Genre, and general templates including helper templates.
    Empty sections are avoided to reduce confusion.
    Templates within each section should be sorted alphabetically.
    General new templates should NOT be defined here; they must be placed in a *-editor-includes file.
    Circular references must be avoided to prevent loops or unintended overrides.
-->
<!-- ======================================================= -->
<xed:template xmlns:mir="http://www.mycore.de/mir" xmlns:xed="http://www.mycore.de/xeditor">

  <!-- ========== Overrides ========== -->
  <!-- Agreement with two links (registration form and terms), the default only supports one.
       The flag in the object contains the URL of the accepted terms (MIR.Agreement.File.URL). -->
  <xed:template id="agreement">
    <xed:if test="not(../../../../service/servflags[@class='MCRMetaLangText']/servflag[@type='agreement']/text()=$MIR.Agreement.File.URL)">
      <xed:if test="xed:call-java('de.gbv.reposis.agreement.VZGAgreementUtil','isOnlySubmitter')">
        <xed:if test="not(contains($MIR.Agreement.Genres.Skip, concat(',',$genre,',')))">
          <xed:bind xpath="../../../../service/servflags[@class='MCRMetaLangText']/servflag[@type='agreement']">
            <fieldset>
              <legend class="mir-fieldset-legend">
                <xed:output i18n="project.form.agreement" />
              </legend>
              <div class="row mt-4 mb-4" id="autor-agreement">
                <div class="offset-3 col-md-9">
                  <div class="form-check required {$xed-validation-marker}">
                    <input class="form-check-input" type="checkbox" value="{$MIR.Agreement.File.URL}"
                           id="autor-agreement-check"></input>
                    <label for="autor-agreement-check" class="form-check-label" id="autor-agreement-link">
                      <xed:output i18n="project.form.agreement.accept.pre" />
                      <a href="{$Clausthal.Agreement.FormURL}" target="_blank"><xed:output
                          i18n="project.form.agreement.accept.link" /></a>
                      <xed:output i18n="project.form.agreement.accept.middle" />
                      <a href="{$Clausthal.Agreement.TermsURL}" target="_blank"><xed:output
                          i18n="project.form.agreement.accept.terms" /></a>
                    </label>
                  </div>
                </div>
              </div>
            </fieldset>
            <xed:validate display="global" xpath="//servflag[@type='agreement']" required="true"
                          i18n="project.form.validation.agreement" />
          </xed:bind>
        </xed:if>
      </xed:if>
    </xed:if>
    <xed:cleanup-rule xpath="//servflag[@type='agreement']" relevant-if="string-length(text())&gt;0" />
  </xed:template>

  <!-- ========== Admin: Modifications ========== -->
  <xed:modify ref="admin.fields">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="subject.complex" />
    <xed:remove ref="related.item.other.search.of.all.items" />
  </xed:modify>

  <!-- ========== Genre: Modifications ========== -->
  <xed:modify ref="genres.av.common">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="comment" />
  </xed:modify>

  <xed:modify ref="genres.book.common">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="comment" />
  </xed:modify>

  <xed:modify ref="genres.entry">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="comment" />
  </xed:modify>

  <xed:modify ref="genres.interview">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="comment" />
  </xed:modify>

  <xed:modify ref="genres.lecture">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="comment" />
  </xed:modify>

  <xed:modify ref="genres.poster">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="comment" />
  </xed:modify>

  <xed:modify ref="genres.preface">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="comment" />
  </xed:modify>

  <xed:modify ref="genres.publication.common">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="comment" />
  </xed:modify>

  <xed:modify ref="genres.report.common">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="comment" />
  </xed:modify>

  <xed:modify ref="genres.research_data">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="comment" />
  </xed:modify>

  <xed:modify ref="genres.speech">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="comment" />
  </xed:modify>

  <xed:modify ref="genres.teaching_material">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="language" />
  </xed:modify>

  <xed:modify ref="genres.thesis.common">
    <xed:remove ref="institutes" />
    <xed:include ref="institutes.repeat" before="comment" />
  </xed:modify>

  <xed:template id="genres.government_publication">
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="title.original" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="editor.repeated" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="year.issued" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="place" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="publisher" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="edition" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="extent" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="language" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="sdnb.repeat" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="identifier.managed" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="doi.handle.urn.repeated" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="subject.simple" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="abstract.simple" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="embargo.datetimepicker" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="rights" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="institutes.repeat" />
    <xed:include uri="xslStyle:editor/mir2xeditor:webapp:editor/editor-includes.xed" ref="comment" />
  </xed:template>

</xed:template>
